<odoo>
    <record id="student_view_form" model="ir.ui.view">
        <field name="model">student.management.student</field>
        <field name="arch" type="xml">
            <form>
		<header>
			<button name="action_confirm_admission"
				string="Confirm Admission"
				type="object"
				invisible="state !='new' "/>

			<button name="action_graduate"
				string="Confirm Graduation"
				type="object"
				invisible="state != 'active' "/>
		</header>
	
		<sheet>
			<notebook>
				<page string="Personal Details">
                			<group>
                    				<field name="name"/>
                    				<field name="age"/>
                    				<field name="email"/>
                    				<field name="date_of_birth"/>
						<field name="gender"/>
					</group>
				</page>
				<page string="Academic Details">
					<group>
                    				<field name="course_fees"/>
						<field name="registration_fees"/>
                                                <field name="total_fees"/>
                    				<field name="active"/>
                    				<field name="department_id"/>
                    				<field name="state"/>
						<field name="course_ids" widget="many2many_tags"/>
                			</group>
				</page>
			</notebook>
		</sheet>
		
            </form>
        </field>
    </record>

    <record id="student_view_list" model="ir.ui.view">
        <field name="model">student.management.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="age"/>
                <field name="email"/>
                <field name="total_fees"/>
                <field name="gender"/>
                <field name="department_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="department_view_form" model="ir.ui.view">
        <field name="model">student.management.department</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="student_ids">
                        <list>
                            <field name="name"/>
                            <field name="age"/>
                            <field name="email"/>
                        </list>
                    </field>
                </group>
            </form>
        </field>
    </record>

    <record id="department_view_list" model="ir.ui.view">
        <field name="model">student.management.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="student_view_search" model="ir.ui.view">
	<field name="model">student.management.student</field>
	<field name="arch" type="xml">
		<search>
			<field name="name"/>
			<field name="email"/>
			<filter name="new_students"
				string="New students"
				domain="[('state','=','new')]"/>
			<filter name="group_by_department"
        			string="Department"
        			context="{'group_by': 'department_id'}"/>
		</search>
	</field>
    </record>

    <record id="department_action" model="ir.actions.act_window">
        <field name="name">Department Action</field>
        <field name="res_model">student.management.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Student Action</field>
        <field name="res_model">student.management.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="student_management_root"
        name="Student Management"/>

    <menuitem
        id="student_menu"
        name="Students"
        parent="student_management_root"/>

    <menuitem
        id="student_records_menu"
        name="Student Records"
        parent="student_menu"
        action="student_action"/>

    <menuitem
        id="department_menu"
        name="Departments"
        parent="student_menu"
        action="department_action"/>

</odoo>
