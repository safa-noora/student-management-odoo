<odoo>

    <record id="student_inherit_view_form" model="ir.ui.view">
        <field name="model">student.management.student</field>
        <field name="inherit_id" ref="student_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">
                <field name="phone"/>
            </xpath>

        </field>
    </record>

</odoo>