<odoo>
	<record id="course_view_list" model="ir.ui.view">
		<field name="model">student.management.course</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
			</list>
		</field>
	</record>
	<record id="course_view_form" model="ir.ui.view">
		<field name="model">student.management.course</field>
		<field name="arch" type="xml">
			<form>
				<group>
					<field name="name"/>
					<field name="student_ids"/>
				</group>
			</form>
		</field>
	</record>
	<record id="course_action" model="ir.actions.act_window">
		<field name="name">Course action</field>
		<field name="res_model">student.management.course</field>
		<field name="view_mode">list,form</field>
	</record>
	<menuitem id="course_menu"
		name="Courses"
		parent="student_management_root"
		action="course_action"/>
		


</odoo>