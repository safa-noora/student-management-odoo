<odoo>

    <!-- QWeb PDF Report Template -->
    <template id="student_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="student">
                <div class="page">

                    <!-- Report Title -->
                    <h2 style="text-align: center; margin-bottom: 5px;">
                        Student Details Report
                    </h2>

                    <p style="text-align: center; color: #666; margin-bottom: 25px;">
                        Student Information
                    </p>

                    <!-- Student Details Table -->
                    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">

                        <thead>
                            <tr style="background-color: #e8eef5;">
                                <th style="width: 35%; padding: 12px; border: 1px solid #bbb; text-align: left;">
                                    Field
                                </th>
                                <th style="width: 65%; padding: 12px; border: 1px solid #bbb; text-align: left;">
                                    Details
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            <!-- Student Name -->
                            <tr>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    Name
                                </td>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    <span t-field="student.name"/>
                                </td>
                            </tr>

                            <!-- Age -->
                            <tr>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    Age
                                </td>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    <span t-field="student.age"/>
                                </td>
                            </tr>

                            <!-- Email -->
                            <tr>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    Email
                                </td>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    <span t-field="student.email"/>
                                </td>
                            </tr>

                            <!-- Phone -->
                            <tr>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    Phone
                                </td>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    <span t-field="student.phone"/>
                                </td>
                            </tr>

                            <!-- Department -->
                            <tr>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    Department
                                </td>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    <span t-field="student.department_id"/>
                                </td>
                            </tr>

                            <!-- Course -->
                            <tr>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    Course
                                </td>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    <span t-field="student.course_id"/>
                                </td>
                            </tr>

                            <!-- Student State -->
                            <tr>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    State
                                </td>
                                <td style="padding: 10px; border: 1px solid #bbb;">
                                    <span t-field="student.state"/>
                                </td>
                            </tr>

                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>


    <!-- PDF Report Action -->
    <record id="action_student_report" model="ir.actions.report">

        <field name="name">Student Details</field>

        <field name="model">student.management.student</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">student_management.student_report_template</field>

        <field name="binding_model_id" ref="model_student_management_student"/>

        <field name="binding_type">report</field>

    </record>

</odoo>
